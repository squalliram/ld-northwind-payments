# Client-side ID from LaunchDarkly: Project settings > Environments > (environment) > Client-side ID.
# This is NOT the server-side SDK key. The SDK key must never be shipped to a browser.
VITE_LD_CLIENT_SIDE_ID=

# Only needed for `npm run ld:setup` (creates flags, segment and metrics via the REST API).
# Create one under Organization settings > Authorization with Writer role. Never commit it.
LD_API_TOKEN=
LD_PROJECT_KEY=northwind-payments
LD_ENVIRONMENT_KEY=test
